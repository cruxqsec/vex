#banner-container {
    width: 1.5fr;
}

#banner {
    content-align: center middle;
    color: $accent;
}

#proxy-list {
    height: 1fr;
    width: 1fr;
    border: round $accent 40%;
    background: transparent;
    margin-left: 20;
    margin-right: 20;
    margin-bottom: 2;
}

#proxy-list:focus {
    border: round $accent 100%;
}

VexProxyListItem {
    align: center middle;
    height:3 !important;
    max-height: 3 !important;
}

VexProxyListItem > Horizontal {
    margin-left: 1;
    margin-right: 1;
    margin-bottom: 1;
    margin-top: 1;
}

#item-row {
    align: center middle;
    height:3 !important;
    max-height: 3 !important;
    width: 1fr;
    padding: 1;
}

.status-dot {
    width: auto;
    color: red;
    content-align: left middle;
    background: $background-lighten-2;
    padding: 0 2;
}

.instance-data {
    width: 6fr;
    content-align: center middle;
    background: $primary-darken-3;
    margin-left: 2;
    margin-right: 2;
}

.status {
    width: auto;
    content-align: right middle;
    background: $background-lighten-2;
    margin-left: 2;
    margin-right: 2;
    padding: 0 2;
}

.active {
    color: $success;
}