VexProxyScreen {
    background: $background;
}

/* ═══════════════════════════════════════════════════════════════════
   Banner
═══════════════════════════════════════════════════════════════════ */

#banner-container {
    width: 1fr;
    height: auto;
    align: center top;
    margin-top: 2;
}

#banner {
    width: 1fr;
    height: auto;
    color: $error;
    text-align: center;
}

#tagline {
    width: 1fr;
    height: 1;
    color: $text-muted;
    text-align: center;
}



/* ═══════════════════════════════════════════════════════════════════
   Main layout
═══════════════════════════════════════════════════════════════════ */

#proxy-main {
    width: 1fr;
    height: 1fr;
    margin-top: 1;
    margin-bottom: 1;
    margin-left: 2;
    margin-right: 1;
}

/* ═══════════════════════════════════════════════════════════════════
   Left panel — VexProxyList
═══════════════════════════════════════════════════════════════════ */

#proxy-list {
    width: 1fr;
    height: 1fr;
    border: none $error-muted;
}

/* Header row */
#proxy-list-header {
    text-style: bold;
    width: 1fr;
    height: 3;
    background: $surface;
    align: left middle;
}

#proxy-list-title {
    width: 1fr;
    height: 1;
    color: $text-muted 40%;
    text-style: bold;
    content-align: left middle;
    margin: 0 2;
}

#btn-create {
    background: $success-muted;
    color: $success;
    margin: 0 1;
}

#btn-edit {
    background: $warning-muted;
    color: $warning;
    margin: 0 1;
}

#btn-delete {
    background: $error-muted;
    color: $error;
    margin: 0 1;
}

/* ListView */
#proxy-listview {
    width: 1fr;
    height: 1fr;
    background: $panel !important;
    padding: 0;
    scrollbar-size: 0 0;
}

#proxy-listview:focus {
    background: $panel  !important;
    background-tint: transparent;
}

#proxy-listview > ListItem {
    height: 3;
    padding: 1 0;
}

#proxy-listview > ListItem.-highlight {
    color: $text;
    background: $primary 10%;
    border-left: thick $error;
}

/* ══════════ Proxy row ═════════════════*/

ProxyListItem {
    width: 1fr;
    border-left: thick $surface;
}

ProxyListItem.row-connected {
    border-left: thick $success;
    background: $success 5%;
}

ProxyListItem.row-busy {
    border-left: thick $warning;
}

.row-inner {
    width: 1fr;
    height: 1fr;
    align: left middle;
}

#instance-dot {
    width: 2;
    height: 1;
    color: $text-muted 30%;
    content-align: left middle;
    margin-left: 1;

    &.connected { color: $success; }
    &.busy { color: $warning; }
}

.row-info {
    width: 1fr;
    height: auto;
}

.row-name {
    width: auto;
    height: 1;
    color: $text;
    margin-left: 1;
}

.name-running {
    color: $success;
}

.row-actions {
    align: right middle;
}

.row-actions VexButton {
    display: none;
}

#btn-stop {
    background: $error-muted;
    color: $error;
    margin: 0 1;
}

#btn-connect, #btn-enter {
    background: $primary-muted;
    color: $primary;
    margin: 0 1;
}

#btn-start {
    background: $success-muted;
    color: $success;
    margin: 0 1;
}

#btn-disconnect {
    background: $warning-muted;
    color: $warning;
    margin: 0 1;
}

#btn-progress {
    background: $surface;
    color: $text-muted;
    margin: 0 1;
}

/* ═══════════════════════════════════════════════════════════════════
   Right panel
═══════════════════════════════════════════════════════════════════ */

#proxy-right {
    width: 0.5fr;
    height: 1fr;
}

/* ═══════════════════════════════════════════════════════════════════
   Status card
═══════════════════════════════════════════════════════════════════ */

#proxy-status-card {
    width: 1fr;
    height: auto;
    margin-left: 2;
    padding-left: 2;
    padding-bottom: 1;
    background: $error-muted 40%;

    &.active {
        background: $success 30%;
    }
}

.status-row {
    height: 2;
    width: 1fr;
    margin: 0;
    padding-top: 1;
}

#status-dot {
    width: 2;
    height: auto;
    color: $error;
    &.active { color: $success; }
}

#status-name {
    width: 1fr;
    height: auto;
    color: $text;
    text-style: bold;
}

#status-meta {
    width: 1fr;
    height: auto;
    color: $text-muted 50%;
}

/* ═══════════════════════════════════════════════════════════════════
   Info card
═══════════════════════════════════════════════════════════════════ */

#proxy-info-card {
    width: 1fr;
    height: 2fr;
    background: $panel;

    border: none $surface;
    margin-left: 2;
    padding-left: 2;
    padding-right: 2;
}

#info-divider {
    color: $text-muted 30%;
    display: none;
}

#info-title {
    height: auto;
    margin-top: 1;
    color: $text-muted 30%;
    text-style: bold;

}

#info-status {
    color: $error;
    &.running { color: $success; }
}

.info-row {
    width: 1fr;
    align: left middle;
}

.info-label {
    height: auto;
    width: 10;
    color: $text-muted 30%;
}

.info-value {
    width: 1fr;
    color: $text;
    text-align: right;
}

.action-connect {
    color: $primary;
}

.action-launch {
    color: $success;
}
