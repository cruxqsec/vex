$border-divider: $secondary-darken-3;

VexHTTPHistoryScreen {
    background: $panel;
}

#http-table-container {
    width: 1.01fr;
    height: 0.8fr;

    background: $panel;
    display: block;
    &.hidden { display: none; }
}

#http-table-header {
    width: 1fr;
    height: 1;
    margin-bottom: 1;
}

#http-search-title {
    width: auto;
    height: 1;
    margin-left: 1;
    background: $panel;

    color: $error;
    text-style: b;
}

#http-search-bar {
    background: $secondary-muted;
    width: 1fr;
    height: 1;
    border: none;
    margin-left: 1;
    margin-right: 3;
}

#http-table-empty {
    width: 1fr;
    height: 1fr;
    background: $background;
}

#http-table {
    width: 1fr;
    height: 1fr;
}

#text-areas {
    display: block;
    &.hidden { display: none; }
    background: $background;
}

#request-area-container {
    height: 1fr;
    width: 1fr;
    background: $background;
}

#response-area-container {
    height: 1fr;
    width: 1fr;
    border: none;
    margin-left: 1;
    background: $background;

}

#history-request-area {
    width: 1fr;
    height: 1fr;
    background: $panel;
    border: none !important;
    padding-left: 1 !important;
    margin: 0 !important;

    &:focus {
        background-tint: $foreground 5%;
    }
}

#history-response-area {
    width: 1fr;
    height: 1fr;
    background: $panel;
    border: none !important;
    padding-left: 1 !important;
    margin: 0 !important;
}

