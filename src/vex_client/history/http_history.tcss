VexHTTPHistoryScreen {
    background: $background;
}

#http-table-container {
    width: 1fr;
    height: 1fr;
    margin-top: 1;

    background: $background;
    background-tint: 0%;
    display: block;
    &.hidden { display: none; }
}

#http-table-header {
    width: 1fr;
    height: 1;
    margin-bottom: 1;
    background: $background;
}

#http-search-title {
    width: auto;
    height: 1;
    margin-left: 1;
    background: $background;

    color: $error;
    text-style: b;
}

#http-search-bar {
    width: 1fr;
    height: 1;
    border: none;
    margin-left: 1;
    margin-right: 3;
}

#http-table-empty {
    width: 1fr;
    height: 1fr;
    background: $background;
}

#http-table {
    width: 1fr;
    height: 1fr;
}

#text-areas {
    display: block;
    &.hidden { display: none; }
    background: $background;
}

#request-area-container {
    height: 1fr;
    width: 1fr;
    background: $background;
    margin-left: 1;
    margin-top: 1;
}

#response-area-container {
    height: 1fr;
    width: 1fr;
    border: none;
    background: $background;
    margin-left: 1;
    margin-right: 1;
    margin-bottom: 1;
    margin-top: 1;

}

#history-request-area {
    width: 1fr;
    height: 1fr;
    background: $panel;
    border: none;
    padding-left: 1;

    &:focus {
        background-tint: $panel 5%;
    }
}

#history-response-area {
    width: 1fr;
    height: 1fr;
    background: $panel;
    background-tint: 0%;
    border: none;
    padding-left: 1;
    margin: 0;
}


AutoComplete {
    & AutoCompleteList {
        max-height: 6;
        color: $text;
        background: $surface;
        border-left: wide $error-muted;
    }

    & .autocomplete--highlight-match {
        color: $text-accent;
        text-style: bold;
    }

    & .option-list--option-highlighted {
        color: $text-success;
        background: $error 50%;
        text-style: italic;
    }
}
