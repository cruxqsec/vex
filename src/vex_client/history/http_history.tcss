$border-divider: $secondary-darken-3;

VexHTTPHistoryScreen {
    background: $panel;
}

#http-table-container {
    width: 1.01fr;
    height: 0.8fr;

    background: $panel;
    display: block;
    &.hidden { display: none; }
}

#http-table-header {
    width: 1fr;
    height: 1;
    margin-bottom: 1;
}

#http-search-title {
    width: auto;
    height: 1;
    margin-left: 1;
    background: $panel;

    color: $error;
    text-style: b;
}

#http-search-bar {
    background: $secondary-muted;
    width: 1fr;
    height: 1;
    border: none;
    margin-left: 1;
    margin-right: 3;
}

#http-table-empty {
    width: 1fr;
    height: 1fr;
    background: $background;
}

#http-table {
    width: 1fr;
    height: 1fr;
}

#text-areas {
    display: block;
    &.hidden { display: none; }
    background: $background;
    border-top: wide $border-divider;
}

#request-area-container {
    height: 1fr;
    width: 1fr;
    background: $background;
}

#response-area-container {
    height: 1fr;
    width: 1fr;
    border: none;
    margin-left: 1;
    background: $background;

}

#history-request-area {
    width: 1fr;
    height: 1fr;
    background: $panel;
    border: none !important;
    padding-left: 1 !important;
    margin: 0 !important;

    &:focus {
        background-tint: $foreground 5%;
    }
}

#history-response-area {
    width: 1fr;
    height: 1fr;
    background: $panel;
    border: none !important;
    padding-left: 1 !important;
    margin: 0 !important;
}


AutoComplete {
    /* Customize the dropdown */
    & AutoCompleteList {
        max-height: 6;  /* The number of lines before scrollbars appear */
        color: $text;  /* The color of the text */
        background: $surface;  /* The background color of the dropdown */
        border-left: wide $error-muted;  /* The color of the left border */
    }

    /* Customize the matching substring highlighting */
    & .autocomplete--highlight-match {
        color: $text-accent;
        text-style: bold;
    }

    /* Customize the text the cursor is over */
    & .option-list--option-highlighted {
        color: $text-success;
        background: $error 50%;  /* 50% opacity, blending into background */
        text-style: italic;  
    }
}