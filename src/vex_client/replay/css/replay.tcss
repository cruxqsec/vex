Screen {
    background: $background;
}

#replay-main-container {
    margin: 1 2;
}

#send-request-bar {
    height: auto;
}

#method-select {
    height: 1;
    border: none !important;
    padding: 0;
    margin: 0;
}

#request-input {
    width: 6fr;
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
}

#replay-request-area {
    width: 1fr;
    border: round $accent 40%;
    margin: 0 1 0 0;
}

#replay-request-area:hover {
    border: round $accent 80%;
}

#replay-request-area.inner-focused {
    border: round $accent 100%;
}

#replay-response-area {
    width: 1fr;
    border: round $accent 40%;
    margin: 0 0 0 1;
}

#replay-response-area:hover {
    border: round $accent 80%;
}

#replay-response-area.inner-focused {
    border: round $accent 100%;
}
