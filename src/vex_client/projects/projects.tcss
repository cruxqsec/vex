/* ═══════════════════════════════════════════════════════════════════
   Main container widget widget
═══════════════════════════════════════════════════════════════════ */

#project-table-container {
    background: transparent;
    width: 1fr;
    height: 1fr;
    margin: 1 3;
}

/* ═══════════════════════════════════════════════════════════════════
   Project table header and title
═══════════════════════════════════════════════════════════════════ */

#project-table-header {
    width: 1fr;
    height: 3;
    background: $surface;
}

#project-table-title {
    width: 3fr;
    height: 3;
    color: $text-muted 40%;
    text-style: bold;
    content-align: left middle;
    margin-left: 2;
    margin-right: 2;
}


/* ═══════════════════════════════════════════════════════════════════
   ActiveProject widget
═══════════════════════════════════════════════════════════════════ */

#active-project-widget {
    width: 1fr;
    height: 3;
    margin-left: 2;
    margin-right: 2;
    margin-top: 1;
    content-align: right middle;
}

#active-project-dot {
    width: 2;
    height: 1fr;
    color: $error-muted;
    text-style: bold;

    &.active {
        color: $success-muted;
    }
}

#active-project-name {
    width: 1fr;
    height: 1fr;
    color: $text-muted;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════
   Button rows and button widgets
═══════════════════════════════════════════════════════════════════ */


#button-row {
    width: 1fr;
    margin-top: 1;
    padding-right: 1;
}

#btn-create {
    background: $success-muted;
    color: $success;
    margin: 0 1;
}

#btn-edit {
    background: $warning-muted;
    color: $warning;
    margin: 0 1;
}

#btn-delete {
    background: $error-muted;
    color: $error;
    margin: 0 1;
}

#btn-import {
    margin-right: 1;
    background: $secondary-muted;
    color: $secondary;
}

#btn-export {
    margin-right: 1;
    background: $accent-muted;
    color: $accent;
}


/* ═══════════════════════════════════════════════════════════════════
   Empty project table container, project table container and helper widget
═══════════════════════════════════════════════════════════════════ */

#project-table-empty {
    width: 1fr;
    height: auto;

    &.empty {
        height: 1fr;
    }
}

#project-table {
    background: $panel;
    width: 1fr;
    height: auto;
}

#project-table-helper {
    width: 1fr;
    height: auto;
    border: round $surface;
    display: block;

    color: $text-muted;
    text-align: center;
    padding: 0 1;
    margin: 0 1;

    &.empty { display: none; }
}
