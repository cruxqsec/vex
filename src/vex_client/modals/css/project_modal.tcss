
CreateUpdateProjectScreen {
        align: center middle;
        background: $surface 80%;

    #modal-window {
        width: 50;
        height: 8;
        background: $background 80%;
    }

    Horizontal {
        margin: 1 1 0 1;
    }

    #title {
        width: 1fr;
        height: 1;
        content-align: left middle;
        background: $primary-darken-3 20%;
        padding-left: 1;
    }

    #project-modal-name-label {
        width: auto;
        height: 0.15fr;
    }

    #project-modal-name-input {
        width: 1fr;
        height: 1;
        border: none;
    }

    #error-label {
        color: $error;
        margin-left: 1;
        margin-bottom: 1;
    }

    #create-btn {
        background: $success-muted !important;
    }

    #update-btn {
        background: $accent-muted !important;
    }

    #cancel-btn {
        background: $error-muted !important;
        color: $text-error !important;
        margin-left: 1;
    }

}
