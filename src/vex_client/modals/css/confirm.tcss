
ConfirmModal {
    align: center middle;
    background: $surface 80%;

    #confirm-window {
        width: 50;
        height: 8;
        background: $background 80%;
    }

    #title {
        width: 1fr;
        height: 1;
        content-align: left middle;
        background: $primary-darken-3 20%;
        padding-left: 1;
        margin-bottom: 1;
    }

    #question-label {
        width: 1fr;
        height: 1;
        color: $text-muted;
        text-style: b;
        margin: 0 1;
        content-align: center middle;
    }

    #buttons-row {
        width: 1fr;
        height: 1fr;
        align: center middle;
        margin-top: 1;
    }

    #confirm-yes {
        color: $success !important;
        background: $success-muted;
        margin-right: 1;
    }

    #confirm-no {
        background: $error-muted !important;
        color: $text-error !important;
        margin-left: 1;
    }
}
