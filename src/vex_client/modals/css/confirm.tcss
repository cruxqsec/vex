$border-divider: $secondary-darken-3;

ConfirmModal {
    align: center middle;
    background: $background 60%;

    #confirm-window {
        width: 50;
        height: 8;
        border: thick $border-divider;
        background: $background;
    }

    #title {
        width: 1fr;
        height: 1;
        content-align: left middle;
        background: $background-lighten-2;
        padding-left: 1;
        margin-bottom: 1;
    }

    #question-label {
        width: 1fr;
        height: 1;
        text-style: b;
        margin: 0 1;
        content-align: center middle;
    }

    #buttons-row {
        width: 1fr;
        height: 1fr;
        align: center middle;
        margin-top: 1;
    }

    #confirm-yes {
        color: $success;
        background: $success-muted 50%;
        margin-right: 1;
    }

    #confirm-no {
        background: $error-muted 50%;
        color: $text-error;
        margin-left: 1;
    }
}
