
/* ═══════════════════════════════════════════════════════════════════
   Screen
═══════════════════════════════════════════════════════════════════ */

#Screen {
    background: $background;
}

/* ═══════════════════════════════════════════════════════════════════
   Main layout
═══════════════════════════════════════════════════════════════════ */

#scope-main-container {
    width: 1fr;
    height: 1fr;
    margin: 1;
}

/* ═══════════════════════════════════════════════════════════════════
   Left panel — Scope list widget
═══════════════════════════════════════════════════════════════════ */

#scope-list-widget {
    width: 1fr;
    height: 1fr;
    background: $background;
    margin-right: 1;
}

/* Header row */
#scope-list-header {
    width: 1fr;
    height: 3;
    background: $surface 80%;

    text-style: bold;
    align: left middle;
}

#scope-list-title {
    width: 1fr;
    height: auto;

    color: $text-muted 40%;
    text-style: b;
    content-align: center middle;
    margin: 0 1;
}

#empty-scope-list {
    width: 1.1fr;
    height: 1fr;
    background: $background;
    padding: 0;
}

#btn-create {
    width: 1fr;
}

/* ListView */
#scope-list {
    width: 1fr;
    height: 1fr;
    background: $panel;
    background-tint: 0%;
    padding: 0;
    scrollbar-size: 0 0;
}

#scope-list-helper {
    width: 1fr;
    height: auto;
    border: round $surface;
    display: block;

    color: $text-muted;
    padding: 0 1;
    margin: 0 1;
}

#scope-list > ListItem {
    height: 3;
    padding: 1 0;

    &.selected {
        border-left: thick $success-muted;
    }
}

#scope-list > ListItem.-highlight {
    background: $primary 20%;
    border-left: thick $accent;
}

/* Row items */
ScopeListItem {
    width: 1fr;
    border-left: thick $surface;
}

.row-inner {
    width: 1fr;
    height: 1fr;
    align: left middle;
}

#scope-dot {
    width: 2;
    height: 1;
    color: $text-muted;
    content-align: left middle;
    margin-left: 1;
}

#scope-name {
    width: 1fr;
    height: 1;
    color: $text;
}

/* ═══════════════════════════════════════════════════════════════════
   Right panel — In/Out scope areas
═══════════════════════════════════════════════════════════════════ */

#in-out-container {
    width: 3fr;
    height: 1fr;
}

/* ═══════════════════════════════════════════════════════════════════
   In/Out input container
═══════════════════════════════════════════════════════════════════ */

#name-input-container {
    width: 1fr;
    height: 3;
    padding: 1 1;
}

/* ═══════════════════════════════════════════════════════════════════
   In/Out container header
═══════════════════════════════════════════════════════════════════ */

#in-out-header {
    height: 3;
    background: $panel;
    margin-bottom: 1;
}

#in-out-title {
    width: auto;
    height: 1;

    background: $panel;
    color: $text-muted 40%;
    text-style: bold;
    content-align: left middle;

    padding-left: 1;
    padding-right: 1;
    margin-top: 1;
}

#scope-name-input {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0 1;
    margin-top: 1;
    margin-right: 1;
}

/* ═══════════════════════════════════════════════════════════════════
   In/Out text areas container
═══════════════════════════════════════════════════════════════════ */

#text-areas-container {
    padding: 0 1;
}

#in-container {
}

#out-container {
}

#in-scope-label {
    background: $panel;
    color: $success;
    text-style: bold;
    margin-bottom: 1;
    margin-right: 1;
    padding: 0 1;
}

#out-of-scope-label {
    background: $panel;
    color: $error;
    text-style: bold;
    margin-bottom: 1;
    padding: 0 1;
}

#in-scope-widget {
    margin-right: 1;
}

#in-scope-area {
    height: 1fr;
    background: $panel;
    padding-left: 1;
    padding-top: 1;
}

#out-of-scope-widget {
}

#out-of-scope-area {
    height: 1fr;
    background: $panel;
    padding-left: 1;
    padding-top: 1;
}

/* ═══════════════════════════════════════════════════════════════════
   In/Out Button area
═══════════════════════════════════════════════════════════════════ */

#btn-area-container {
    height: auto;
    margin: 1 0 0 0;
    align: left middle;
}

#btn-save {
    background: $accent-muted;
    color: $accent;
    margin: 0 1;
}

#btn-duplicate {
    background: $primary-muted;
    color: $primary;
    margin: 0 1;
}

#btn-delete {
    background: $error-muted;
    color: $error;
    margin: 0 1;
}
