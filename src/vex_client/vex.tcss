$empty-hatch: right $surface-lighten-1 70%;

.func-btn {
    padding: 0 1;
    width: auto;
    height: 1;
    border: none;

    background: $accent-muted;
    color: $text-accent;
    text-style: b;
    &:hover {
        background-tint: $text-accent 10%;
    }
    
    &:focus {
        background-tint: $text-accent 30%;
    }

}

ScopeSelect > SelectCurrent {
    outline: thick transparent;
    color: $foreground;
    background: $surface;
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    margin-top: 0 !important;
}

VexDataTable {
    overflow-x: hidden;
    scrollbar-size-vertical: 0;
    scrollbar-gutter: auto;
    margin: 0;
}

VexTextArea {
    background: $background;
    
    scrollbar-size-vertical: 0;
    scrollbar-gutter: auto;

    margin: 0;
    padding: 0;
    border: none;

    border-subtitle-color: $foreground;
    border-subtitle-background: $background;
    border-subtitle-style: bold;
    border-subtitle-align: left;

    &.visual-mode {
        border-subtitle-background: $accent;
        border-subtitle-style: bold;
    }
    
    &.text-area--selection {
            background: $accent 60%;
    }


    &.insert-mode {

    }
}