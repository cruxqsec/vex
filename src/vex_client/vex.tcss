$empty-hatch: right $surface-lighten-1 70%;

.func-btn {
    padding: 0 1;
    width: auto;
    height: 1;
    border: none;

    background: $accent-muted;
    color: $text-accent;
    text-style: b;
    &:hover {
        background-tint: $text-accent 10%;
    }
    
    &:focus {
        background-tint: $text-accent 30%;
    }

}

ScopeSelect > SelectCurrent {
    outline: thick transparent;
    color: $foreground;
    background: $surface;
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    margin-top: 0 !important;
}
