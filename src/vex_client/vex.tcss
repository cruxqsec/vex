$empty-hatch: right $surface-lighten-1 70%;
$border-divider: $secondary-darken-3;

Screen {
    scrollbar-size: 0 0;
}

/* ═══════════════════════════════════════════════════════════════════
   VexButton class (all buttons)
═══════════════════════════════════════════════════════════════════ */

.btn {
    width: auto;
    height: 1;
    border: none !important;

    text-style: b;
    &:hover {
        background-tint: $text-accent 10%;
    }
    
    &:focus {
        background-tint: $text-accent 30%;
    }
}

/* ═══════════════════════════════════════════════════════════════════
   Vex Navigation Bar and corresponding widgets
═══════════════════════════════════════════════════════════════════ */

VexNavigationBar {
    width: 1fr;
    height: 1;
    layout: horizontal;
    dock: top;
    border-bottom: wide $border-divider;
    box-sizing: content-box;

    &.bottom {
        dock: bottom;
    }

    &.left {
        layout: vertical;
        dock: left;
        width: 20;
    }
    &.right {
        layout: vertical;
        dock: right;
        width: 20;
    }
}

InterceptButton {
    width: auto;
    height: 1;
    dock: right;
    border-left: wide $border-divider;
    
    background: $success 20%;
    color: $success !important;


    &:hover {
        background: $success 50%;
    }

    &.intercepting {
        background: $error 20%;
        color: $error !important;
        
        &:hover {
            background: $error 50%; 
        }
    }
}

NavigationButton {
    width: 1fr;
    height: auto;
    border-left: wide $border-divider;

    text-align: left;
    background: $surface 50%;
    color: $text-muted;

    &:hover { background: $surface; }

    &.active {
        color: $primary;
        background: $primary 30%;
        &:hover { background: $primary 50%; }
    }
}    

ScopeSelect > SelectCurrent {
    height: 1;
    width: 1fr;

    border: none !important;
    color: $foreground;
    background: $surface;
}

/* ═══════════════════════════════════════════════════════════════════
   Global VexDataTable widget CSS
═══════════════════════════════════════════════════════════════════ */

VexDataTable {
    overflow-x: hidden;
    scrollbar-size-vertical: 0;
    scrollbar-gutter: auto;
    margin: 0;

    & > .datatable--cursor {
        background: $primary 30%;
        color: $text;
    }
    & > .datatable--header {
        background: $secondary-darken-2 30%;
    }

    & > .datatable--header-hover {
        background: $secondary-darken-2 30%;
    }

    & > .datatable--odd-row {
    }

    & .vex-datatable--method-get    { color: $method-get; }
    & .vex-datatable--method-post   { color: $method-post; }
    & .vex-datatable--method-put    { color: $method-put; }
    & .vex-datatable--method-delete { color: $method-delete; }
    & .vex-datatable--method-patch  { color: $method-patch; }
    & .vex-datatable--method-options{ color: $method-options; }
    & .vex-datatable--method-head   { color: $method-head; }

    & .vex-datatable--status-success  { color: $success; }
    & .vex-datatable--status-redirect { color: $warning; }
    & .vex-datatable--status-error    { color: $error; }

    & .vex-datatable--ext-html { color: $ext-html; }
    & .vex-datatable--ext-css  { color: $ext-css; }
    & .vex-datatable--ext-js   { color: $ext-js; }
    & .vex-datatable--ext-ts   { color: $ext-ts; }
    & .vex-datatable--ext-php  { color: $ext-php; }
    & .vex-datatable--ext-json { color: $ext-json; }
    & .vex-datatable--ext-pdf  { color: $ext-pdf; }
    & .vex-datatable--ext-png  { color: $ext-png; }
    & .vex-datatable--ext-jpg  { color: $ext-jpg; }
    & .vex-datatable--ext-svg  { color: $ext-svg; }

    & .vex-datatable--cookie-yes { color: $success; }
    & .vex-datatable--cookie-no  { color: $error; }

    & .vex-datatable--sort-asc  { 
        color: $success; 
    }
    & .vex-datatable--sort-desc { 
        color: $error; 
    }

}

/* ═══════════════════════════════════════════════════════════════════
   VexTextArea
═══════════════════════════════════════════════════════════════════ */

VexTextArea {
    background: $background;
    
    scrollbar-size-vertical: 0;
    scrollbar-gutter: auto;

    margin: 0;
    padding: 0;
    border: none;

    &.visual-mode {
        border-subtitle-background: $accent;
        border-subtitle-style: bold;
    }
    
    &.text-area--selection {
            background: $accent 60%;
    }


    &.insert-mode {

    }
}

VexTextAreaWidget {
    & #vim-status-bar {
        height: 1;
        background: $surface-lighten-1;
    }

    & #vim-mode {
        height: auto;
        width: auto;
        dock: left;

        background: $primary-muted;
        color: $text;

        margin-left: 3;
        padding: 0 2;
    }

    & #vim-position {
        width: auto;
        height: auto;
        dock: right;

        color: $text;
        margin-right: 3;
    }

    & #vim-mode.vim-visual {
        background: $accent-muted;
    }

    
}

/* ═══════════════════════════════════════════════════════════════════
   CommandPallete
═══════════════════════════════════════════════════════════════════ */

CommandPalette {
    background: black 33%;
    align: center middle;

    & > Vertical {
        margin-top: 2;
        width: 65vw;
        max-height: 65vh;
    }

    & #--input {
        border: none;
        border-left: wide $accent;
    }

    & #--input CommandInput {
        height: 3;
        border: none;
        padding: 1 2;
    }

    & #--input SearchIcon {
        display: none;
    }

    & CommandList {
        border: none;
        border-left: wide $accent;
        padding-bottom: 1;
    }
}

/* ═══════════════════════════════════════════════════════════════════
   Footer and the footer elements
═══════════════════════════════════════════════════════════════════ */

$footer-background: $surface

VexFooter {
    dock: bottom;
    height: 1;
    background: $footer-background;
    layout: horizontal;
    box-sizing: content-box;
}

#left-side {
    dock: left;
    width: auto;
    height: 1;
    margin: 0 !important;
    padding: 0 !important;
}

#right-side {
    dock: right;
    width: auto;
    height: 1;
}

VexCmdKey {
    background: $panel;
    background: $footer-background;
    layout: horizontal;
    width: auto;

    & .key {
        background: $footer-background;
        color: $accent;
    }

    & .description {
        padding: 0 1;
        color: $text-muted;
    }
}

Seperator {
    background: $footer-background;
    color: $accent;
    width: auto;
}

VersionKey {
    background: $footer-background;
    color: $text-muted;
    width: auto;
    padding: 0 1;
    &:hover { background: $surface; }
}

LogsKey {
    background: $footer-background;
    color: $text-muted;
    width: auto;
    padding: 0 1;
    &:hover { background: $surface; }
}

CommandPaletteKey {
    background: $footer-background;
    color: $text-muted;
    width: auto;
    padding: 0 1;
    &:hover { background: $surface; }
}

OnlineKey {
    color: $background;
    background: $error;
    height: 1;
    padding: 0 1;
    width: auto;
    &.online { background: $success; }
}

/* ═══════════════════════════════════════════════════════════════════
   LogsPanel widget
═══════════════════════════════════════════════════════════════════ */

VexLogsPanel {
    dock: bottom;
    display: none;
    height: 10;
    border-top: tab $secondary;

    & #log-output {
        background: $panel;
        margin-bottom: 1;
        scrollbar-size-vertical: 0;
        scrollbar-gutter: auto;
    }

    &.visible {
        display: block;
        margin: 0;
    }
}

EmptyMessageWidget {
    layers: below above;

    & #empty-message {
        display: none;
    }

    &.empty {
        & VexTextArea { layer: below; }
        & VexDataTable { layer: below; }
        & ScopeList { layer: below; }

        & #empty-message {
            color: $text-muted;
            hatch: $empty-hatch;
            display: block;
            layer: above;
        }
    }
}

