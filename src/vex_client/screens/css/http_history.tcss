#main-container {
    margin: 0 1; 
}

#http-table {
    width: 1fr;
    height: 1fr;
    background: transparent;
    border: round $foreground;
}

#http-table:hover {
    border: round $accent;
}

#http-table.inner-focused {
    border: round $primary;
}

#request-area {
    width: 1fr;
    border: round $foreground;
    margin: 0 1 0 0;
}

#response-area {
    width: 1fr;
    border: round $foreground;
    margin: 0 0 0 1;
}