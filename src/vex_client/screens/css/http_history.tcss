#http-table {
    width: 1fr;
    height: 1fr;
    background: transparent;
    border: round $foreground;
    margin: 0 !important;
    padding: 0 !important;
}

#http-table:hover {
    border: round $primary;
}

#http-table.inner-focused {
    border: round $primary;
}

#text-areas {
    display: block;
}

#text-areas.empty {
    display: none;
}

#request-area {
    width: 1fr;
    border: round $foreground;
}

#request-area:hover {
    border: round $primary;
}

#request-area.inner-focused {
    border: round $primary;
}

#response-area {
    width: 1fr;
    border: round $foreground;
}

#response-area:hover {
    border: round $primary;
}

#response-area.inner-focused {
    border: round $primary;
}