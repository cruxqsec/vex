Screen {
    background: $background;
}

#main-container {
    margin: 1 2;
}

#send-request-bar {
    height: auto;
}

#method-select {
    height: 1;
    border: none !important;
    padding: 0;
    margin: 0;
}

#request-input {
    width: 6fr;
    height: 1;
    margin: 0;
    padding: 0 1;
    border: none;
}

#request-area {
    width: 1fr;
    border: round $foreground;
    margin: 0 1 0 0;
}

#request-area:hover {
    border: round $accent;
}

#request-area.inner-focused {
    border: round $primary;
}

#response-area {
    width: 1fr;
    border: round $foreground;
    margin: 0 0 0 1;
}

#response-area:hover {
    border: round $accent;
}

#response-area.inner-focused {
    border: round $primary;
}
