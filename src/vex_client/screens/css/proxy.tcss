Screen {
    align: center middle;
    background: $background;
}

#banner-container {
    align: center middle;
}

#main-container {
    align: center middle;
}

#banner {
    height: 1fr;
    width: 1fr;
    content-align: center middle;
    background: $background;
    color: $accent;
}

#website-link {
    content-align: center middle;
    background: $accent-muted;
    color: $text-accent;
    padding: 0 2;
    margin-bottom: 1;
}

#version {
    width: auto;
    height: auto;
    content-align: center middle;
    background: $background-lighten-2;
    color: $accent;
    padding: 0 2;
    margin-bottom: 3;
    text-style: bold;
}

#proxy-list {
    width: 1fr;
    border: tab $foreground;
    background: $background;
    margin-left: 20;
    margin-right: 20;
    margin-bottom: 2;
    
        
}

VexProxyListItem {
    align: center middle;
    height:3 !important;
    max-height: 3 !important;
}

Horizontal {
    margin-left: 1;
    margin-right: 1;
    margin-bottom: 1;
    margin-top: 1;
}

#item-row {
    align: center middle;
    height:3 !important;
    max-height: 3 !important;
    width: 1fr;
    padding: 1;
}

.status-dot {
    width: auto;
    color: red;
    content-align: left middle;
    background: $background-lighten-2;
    padding: 0 2;
}

.instance-data {
    width: 6fr;
    content-align: center middle;
    background: $primary-darken-3;
    margin-left: 2;
    margin-right: 2;
}

.status {
    width: auto;
    content-align: right middle;
    background: $background-lighten-2;
    margin-left: 2;
    margin-right: 2;
    padding: 0 2;
}
.active {
    color: green;
}
