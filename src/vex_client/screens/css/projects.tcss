VexProjectsScreen {
    background: $background;

    #main-container {
        margin: 1 4;
    }

    #active-project {
        width: 1fr;
        height: 1fr;
    }

    #navigation-bar {
        width: 1fr;
        height: 1fr;
    }

    #projects-table{
        width: 1fr;
        height: 8fr;
        border: wide $foreground;
        margin: 1 0;
    }

    
}