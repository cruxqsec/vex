VexProjectsScreen {
    background: $background;
}

#main-container {
    margin: 1 4;
}

#active-project {
    width: 1fr;
    height: 1fr;
}

#navigation-bar {
    width: 1fr;
    height: 1fr;
}

#projects-table {
    background: transparent;
    width: 1fr;
    height: 8fr;
    border: round $foreground;
    margin: 1 0;
}

#projects-table:hover {
    border: round $accent;
}

#projects-table.inner-focused {
    border: round $primary;
}